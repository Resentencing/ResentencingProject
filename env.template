# === HOW TO USE THIS FILE ===
# Copy this file to .env before running the app:
#   On Unix/macOS/Git Bash:   cp env.template .env
#   On Windows PowerShell:     Copy-Item env.template .env
#   On Windows CMD:            copy env.template .env
# Then edit .env and fill in your real secrets and configuration values.
# Never commit your .env file to git!
# =============================

# PythonAnywhere Database Configuration
PYTHONANYWHERE_USERNAME=your_username
PYTHONANYWHERE_PASSWORD=your_website_password
SSH_HOST=ssh.pythonanywhere.com
PYTHONANYWHERE_DB_PASSWORD=your_mysql_password
PYTHONANYWHERE_DB_NAME=your_username$your_database_name

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Flask Configuration
FLASK_SECRET_KEY=your_flask_secret_key
FLASK_DEBUG=True
UNLIMITED_ACCESS_ROLE=priority_access

# Optional JSON role overrides for Tool Hub access tiers.
# Keep a two-tier model by default:
# - default: capped by DOWNLOADS_PER_HOUR / DOWNLOADS_PER_DAY / ZIPS_PER_DAY
# - priority_access (or UNLIMITED_ACCESS_ROLE): unlimited
# Example:
# ROLE_LIMITS_JSON={"default":{"downloads_per_hour":10,"downloads_per_day":50,"zips_per_day":3,"unlimited":false},"priority_access":{"unlimited":true}}
ROLE_LIMITS_JSON={}

# Database Configuration
DB_HOST=your_db_host
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
TABLE_NAME=pdfs
ARCHIVE_DIR=/home/youruser/shared/archive_directory
LOG_DIR=/home/youruser/mysite/logs

ADMIN_PASSWORD=password

# Dropbox Sync (for dropbox_sync.py)
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token
DROPBOX_FOLDER=/1172.1 Letters

# ===== STREAMLIT RAG HANDOFF =====
# Shared secret used by Flask (gate) and Streamlit (RAG agent) to HMAC-sign
# the handoff URL. Generate a strong random value, e.g.:
#   python -c "import secrets;print(secrets.token_hex(32))"
# NOTE: setting this also enables HMAC signature checks on Flask's
# /access/session magic-link endpoint, so any external magic-link generator
# must use the same secret.
ACCESS_HANDOFF_SECRET=

# Public URL of the Streamlit RAG app (no trailing slash). Leave empty to
# hide the "Open Streamlit RAG Agent" button on the Tool Hub.
#   Local dev:        http://localhost:8504
#   PythonAnywhere:   https://your-streamlit-host.example.com
STREAMLIT_BASE_URL=http://localhost:8504

# How long the launch token is valid (seconds). Short = safer.
STREAMLIT_TOKEN_TTL_SECONDS=300

# Streamlit-side auth switch. true (default) = require a valid handoff token;
# false = allow direct access to :8504 with NO auth (local dev only).
STREAMLIT_AUTH_REQUIRED=true

# (Optional) Public URL of Flask /access page; shown to unauthorized
# Streamlit visitors as a "Go to access page" link.
ACCESS_GATE_URL=http://localhost:5001/access